  BeastId: baiyuan
  DisplayName: "\u767D\u733F"
  Element: 4
  Role: 5
  Rarity: 1
  Source: "\u300A\u5434\u8D8A\u6625\u79CB\u300B"
  Quote: "\u8D8A\u6709\u5904\u5973\uFF0C\u51FA\u4E8E\u5357\u6797\uFF0C\u56FD\u4EBA\u79F0\u5584\u3002\u5C06\u5317\u89C1\u4E8E\u738B\uFF0C\u9053\u9022\u4E00\u7FC1\uFF0C\u81EA\u79F0\u66F0\u8881\u516C\u2026\u2026\u4E43\u6756\u7BB8\u4E8E\u7AF9\uFF0C\u672B\u6298\u5815\u5730\uFF0C\u8881\u516C\u5373\u98DE\u4E0A\u6811\uFF0C\u5316\u4E3A\u767D\u733F\u3002"
  Lore: "\u5357\u6797\u7684\u7AF9\u68A2\u4E0A\u5750\u7740\u4E00\u4F4D\u767D\u6BDB\u8001\u8005\u3002\u4ED6\u6559\u4EBA\u5251\u672F\uFF0C\u4ECE\u4E0D\u4EB2\u81EA\u51FA\u624B\uFF0C\u53EA\u628A\u7AF9\u679D\u6298\u65AD\u4E86\u6254\u4E0B\u6765\u2014\u2014\u63A5\u7740\u90A3\u4E00\u7529\uFF0C\u5C31\u662F\u8FD9\u4E16\u95F4\u6700\u597D\u7684\u5251\u6CD5\u4E86\u3002\u4ED6\u8D70\u7684\u90A3\u5929\uFF0C\u4EBA\u53EA\u770B\u89C1\u4E00\u9053\u767D\u5F71\u4E0A\u4E86\u6811\u3002"
  Codex: "\u5357\u6797\u7684\u7AF9\u4E0A\u6709\u4E00\u9053\u65E7\u75A4\u3002\u6751\u91CC\u7684\u8001\u4EBA\u8BF4\uFF0C\u90A3\u662F\u8881\u516C\u98DE\u4E0A\u53BB\u65F6\u7559\u7684\uFF1B\u5E74\u8F7B\u4EBA\u8BF4\uFF0C\u662F\u98CE\u522E\u7684\u3002\u4E24\u79CD\u8BF4\u6CD5\uFF0C\u8C01\u4E5F\u6CA1\u6253\u7B97\u8BF4\u670D\u8C01\u3002"
  TraitName: "\u5251\u52BF\u53E0\u950B"
  TraitDescription: "\u666E\u653B\u6BCF\u547D\u4E2D\u540C\u4E00\u76EE\u6807\u4E00\u6B21\uFF0C\u5BF9\u5B83\u7684\u4F24\u5BB3
    +10%\uFF08\u53EF\u53E0\uFF0C\u5207\u76EE\u6807\u91CD\u7F6E\uFF09\uFF1B\u8FDE\u51FB\u8D85\u8FC7
    3 \u6B21\u540E\uFF0C\u81EA\u8EAB\u653B\u901F\u63D0\u5347\u3002"
