  BeastId: zhuhuai
  DisplayName: "\u8BF8\u6000"
  Element: 1
  Role: 2
  Rarity: 2
  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u5317\u5C71\u7ECF\u300B"
  Quote: "\u53C8\u5317\u4E09\u767E\u91CC\uFF0C\u66F0\u5317\u5CB3\u4E4B\u5C71\uFF0C\u591A\u67B3\u68D8\u521A\u6728\u3002\u6709\u517D\u7109\uFF0C\u5176\u72B6\u5982\u725B\u800C\u56DB\u89D2\u3001\u4EBA\u76EE\u3001\u5F58\u8033\uFF0C\u5176\u540D\u66F0\u8BF8\u6000\uFF0C\u97F3\u5982\u9E23\u96C1\uFF0C\u662F\u98DF\u4EBA\u3002"
  Lore: "\u5317\u5CB3\u4E4B\u5C71\u7684\u67B3\u68D8\u751F\u5F97\u5BC6\u5982\u6805\u680F\uFF0C\u8BF8\u6000\u5C31\u5728\u8FD9\u7247\u523A\u4E1B\u91CC\u8FC7\u51AC\u3002\u5B83\u56DB\u89D2\u5206\u53C9\u5982\u540C\u6B8B\u679D\uFF0C\u4EBA\u76EE\u5706\u7741\u4E0D\u7728\uFF0C\u5F58\u8033\u8D34\u4F0F\u4E0D\u52A8\u2014\u2014\u5B83\u5E76\u4E0D\u8FFD\u4EBA\uFF0C\u53EA\u662F\u7AD9\u5728\u552F\u4E00\u7684\u901A\u8DEF\u4E2D\u592E\uFF0C\u7B49\u7740\u5FC5\u7ECF\u4E4B\u4EBA\u81EA\u5DF1\u649E\u4E0A\u6765\u3002"
  Codex: "\u5317\u5CB3\u7684\u730E\u6237\u4F20\u4E0B\u4E00\u53E5\u8BDD\uFF1A\u89C1\u4E86\u8BF8\u6000\u522B\u8DD1\u3002\u5B83\u56DB\u89D2\u5F20\u5F00\u65F6\u50CF\u4E00\u4E1B\u67AF\u679D\uFF0C\u4F60\u8DD1\u5F97\u6025\uFF0C\u53CD\u800C\u5BB9\u6613\u628A\u90A3\u4E1B\u67AF\u679D\u5F53\u6210\u53BB\u8DEF\u3002"
  TraitName: "\u7360\u7259\u8D2F\u6728"
  TraitDescription: "\u5965\u4E49\u5BF9\u5355\u4F53\u76EE\u6807\u989D\u5916\u89E6\u53D1\u4E00\u6B21
    80% \u7684\u91CD\u51FB\uFF1B\u88AB\u91CD\u51FB\u547D\u4E2D\u7684\u76EE\u6807\u9632\u5FA1
    -15%\uFF082 \u56DE\u5408\uFF09\u3002"
