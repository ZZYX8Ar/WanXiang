  BeastId: pixiu
  DisplayName: "\u8C94\u8C85"
  Element: 4
  Role: 2
  Rarity: 3
  Source: "\u300A\u53F2\u8BB0\u300B"
  Quote: "\u8C94\u8C85\uFF0C\u9F99\u4E4B\u5B50\uFF0C\u8EAB\u5F62\u5982\u864E\u8C79\uFF0C\u5176\u9996\u5C3E\u4F3C\u9F99\uFF0C\u5176\u8272\u4EA6\u91D1\u4EA6\u7389\uFF0C\u5176\u80A9\u751F\u53CC\u7FFC\uFF0C\u5176\u53E3\u5927\u5F20\u800C\u65E0\u809B\uFF0C\u6545\u80FD\u7EB3\u4E07\u7269\u800C\u4E0D\u6CC4\u3002"
  Lore: "\u8C94\u8C85\u8EAB\u4E0A\u53EA\u6709\u9032\u53E3\u6CA1\u6709\u51FA\u53E3\uFF0C\u6240\u4EE5\u5B83\u5403\u4E0B\u7684\u4E1C\u897F\u6C38\u8FDC\u7559\u5728\u8EAB\u4F53\u91CC\u3002\u4F20\u8BF4\u5B83\u6700\u521D\u662F\u88AB\u6D3E\u53BB\u5B88\u5929\u5E93\u7684\uFF0C\u5B88\u5230\u81EA\u5DF1\u90FD\u88C5\u4E0D\u4E0B\u4E86\uFF0C\u4E5F\u6CA1\u820D\u5F97\u5410\u51FA\u6765\u4E00\u4EF6\u3002"
  Codex: "\u5546\u961F\u7684\u65D7\u4E0A\u90FD\u7EE3\u8C94\u8C85\u3002\u7EE3\u7684\u65F6\u5019\u8981\u7528\u91D1\u7EBF\uFF0C\u4E14\u5FC5\u987B\u628A\u5634\u7EE3\u6210\u5F20\u5F00\u7684\u2014\u2014\u5408\u4E86\u5634\u7684\u8C94\u8C85\uFF0C\u5C31\u4E0D\u53EB\u8C94\u8C85\u4E86\u3002"
  TraitName: "\u541E\u91D1\u7EB3\u5B9D"
  TraitDescription: "\u51FB\u6740\u654C\u65B9\u5355\u4F4D\u540E\u6C38\u4E45\u83B7\u5F97\u5176
    10% \u653B\u51FB\uFF08\u53EF\u53E0\uFF0C\u4E0A\u9650 +40%\uFF09\uFF1B\u82E5\u51FB\u6740\u5219\u6211\u65B9\u5168\u4F53\u7075\u529B
    +3\u3002"
