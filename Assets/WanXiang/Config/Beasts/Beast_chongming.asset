  Quote: "\u5C27\u5728\u4F4D\u4E03\u5341\u5E74\u2026\u2026\u6709\u7957\u652F\u4E4B\u56FD\u732E\u91CD\u660E\u4E4B\u9E1F\uFF0C\u4E00\u540D\u53CC\u775B\uFF0C\u8A00\u53CC\u775B\u5728\u76EE\u3002\u72B6\u5982\u9E21\uFF0C\u9E23\u4F3C\u51E4\u3002"
  Lore: "\u9E21\u5F62\u51E4\u58F0\uFF0C\u53CC\u773C\u91CC\u5404\u6709\u4E00\u4E2A\u773C\u73E0\uFF0C\u6545\u540D\u300C\u91CD\u660E\u300D\u3002\u5B83\u80FD\u9A71\u9B3C\u907F\u90AA\uFF0C\u53E4\u4EBA\u628A\u5B83\u7684\u5F62\u8C61\u8D34\u5728\u95E8\u4E0A\uFF0C\u4EE3\u66FF\u8001\u864E\u548C\u96C4\u9E21\u2014\u2014\u8FD9\u662F\u6700\u65E9\u7684\u95E8\u795E\u4E4B\u4E00\u3002"
  Codex: "\u8D34\u5B83\u4E00\u6B21\uFF0C\u4E00\u5E74\u4E0D\u51FA\u95E8\u4E5F\u5B89\u5FC3\u3002"
