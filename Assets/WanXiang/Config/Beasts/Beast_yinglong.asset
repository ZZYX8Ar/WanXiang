  BeastId: yinglong
  DisplayName: "\u5E94\u9F99"
  Element: 5
  Role: 2
  Rarity: 3
  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u5927\u8352\u4E1C\u7ECF\u300B\u300A\u5927\u8352\u5317\u7ECF\u300B"
  Quote: "\u5E94\u9F99\u5904\u5357\u6781\uFF0C\u6740\u86A9\u5C24\u4E0E\u5938\u7236\uFF0C\u4E0D\u5F97\u590D\u4E0A\uFF0C\u6545\u4E0B\u6570\u65F1\u3002\u2026\u2026\u5E94\u9F99\u755C\u6C34\u3002"
  Lore: "\u6709\u7FFC\u4E4B\u9F99\u3002\u5B83\u6740\u4E86\u86A9\u5C24\u4E0E\u5938\u7236\uFF0C\u7ACB\u4E0B\u5927\u529F\uFF0C\u5374\u56E0\u4E3A\u8017\u5C3D\u4E86\u529B\u6C14\u518D\u4E5F\u56DE\u4E0D\u4E86\u5929\u4E0A\uFF0C\u53EA\u80FD\u7559\u5728\u4EBA\u95F4\u84C4\u6C34\u3002\u5B83\u843D\u4E0B\u53BB\u7684\u5730\u65B9\uFF0C\u5929\u5C31\u4E0D\u518D\u4E0B\u96E8\u3002"
  Codex: "\u5B83\u66FE\u98DE\u8FC7\u6700\u9AD8\u7684\u5929\uFF0C\u6240\u4EE5\u6700\u61C2\u4F4E\u5904\u7684\u6C34\u3002"
  TraitName: "\u755C\u6C34"
  TraitDescription: "\u6218\u6597\u5F00\u59CB\u65F6\uFF0C\u81EA\u8EAB\u7D2F\u79EF\u300C\u6C34\u52BF\u300D\uFF08\u6BCF\u56DE\u5408
    +2 \u5C42\uFF0C\u4E0A\u9650 20 \u5C42\uFF09\uFF1B\u6BCF\u5C42\u4F7F\u81EA\u8EAB\u4E0B\u4E00\u6B21\u4F24\u5BB3\u6027\u6280\u80FD
    +6%\u3002\u4F7F\u7528\u7EDD\u6280\u540E\u6E05\u7A7A\u6C34\u52BF\u3002\u51FB\u6740\u654C\u65B9\u5355\u4F4D\u65F6\uFF0C\u6C34\u52BF
    +5 \u5C42\u3002"
