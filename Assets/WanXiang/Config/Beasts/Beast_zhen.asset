  BeastId: zhen
  DisplayName: "\u9E29"
  Element: 2
  Role: 5
  Rarity: 1
  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u4E2D\u5C71\u7ECF\u300B"
  Quote: "\u53C8\u4E1C\u4E8C\u767E\u91CC\uFF0C\u66F0\u5973\u51E0\u4E4B\u5C71\uFF0C\u5176\u4E0A\u591A\u7389\uFF0C\u5176\u4E0B\u591A\u9EC4\u91D1\uFF0C\u5176\u517D\u591A\u8C79\u864E\uFF0C\u591A\u95FE\u9E8B\u9E96\u9E82\u3002\u5176\u9E1F\u591A\u767D\u9DEE\uFF0C\u591A\u7FDF\uFF0C\u591A\u9E29\u3002"
  Lore: "\u5973\u51E0\u4E4B\u5C71\u7684\u7389\u662F\u9752\u7684\uFF0C\u9E29\u7684\u7FBD\u662F\u9ED1\u91CC\u900F\u8D64\u7684\u3002\u5B83\u6816\u5728\u6700\u9AD8\u7684\u90A3\u682A\u8346\u4E0A\uFF0C\u5599\u77ED\u800C\u94A9\uFF0C\u53EA\u5403\u4E00\u79CD\u4E1C\u897F\u2014\u2014\u522B\u7684\u9E1F\u5544\u8FC7\u7684\u679C\u3002\u5C71\u6C11\u8BF4\uFF0C\u88AB\u9E29\u5544\u8FC7\u7684\u679C\u5B50\u843D\u5730\uFF0C\u4E09\u5E74\u4E0D\u957F\u8349\u3002"
  Codex: "\u5973\u51E0\u4E4B\u5C71\u6709\u53E5\u8001\u8BDD\u4F20\u4E86\u51E0\u4EE3\uFF1A\u300C\u9E29\u4E0D\u72EC\u996E\u300D\u3002\u5B83\u8854\u6765\u7684\u6BD2\u4ECE\u4E0D\u662F\u7ED9\u81EA\u5DF1\u7528\u7684\uFF0C\u662F\u7ED9\u6C34\u7528\u7684\u2014\u2014\u8FD9\u4E5F\u662F\u4E3A\u4EC0\u4E48\u5C71\u91CC\u7684\u6CC9\uFF0C\u90FD\u8981\u5148\u656C\u4E00\u656C\u624D\u6562\u559D\u3002"
  TraitName: "\u4E03\u6B65\u65AD\u9B42"
  TraitDescription: "\u666E\u653B\u547D\u4E2D\u7684\u76EE\u6807\u6BCF\u5C42\u707C\u70E7\u989D\u5916
    -3% \u9632\u5FA1\uFF08\u53EF\u53E0\u52A0\uFF09\uFF1B\u82E5\u76EE\u6807\u5E26\u707C\u70E7\uFF0C\u81EA\u8EAB\u666E\u653B\u4F24\u5BB3
    +20%\u3002"
