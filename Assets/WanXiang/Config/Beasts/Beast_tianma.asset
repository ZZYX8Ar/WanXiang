  BeastId: tianma
  DisplayName: "\u5929\u9A6C"
  Element: 1
  Role: 4
  Rarity: 3
  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u5317\u5C71\u7ECF\u300B"
  Quote: "\u53C8\u4E1C\u5317\u4E8C\u767E\u91CC\uFF0C\u66F0\u9A6C\u6210\u4E4B\u5C71\uFF0C\u5176\u4E0A\u591A\u6587\u77F3\uFF0C\u5176\u9634\u591A\u91D1\u7389\u3002\u6709\u517D\u7109\uFF0C\u5176\u72B6\u5982\u767D\u72AC\u800C\u9ED1\u5934\uFF0C\u89C1\u4EBA\u5219\u98DE\uFF0C\u5176\u540D\u66F0\u5929\u9A6C\uFF0C\u5176\u9E23\u81EA\u8A06\u3002"
  Lore: "\u9A6C\u6210\u4E4B\u5C71\u7684\u6587\u77F3\u5728\u96E8\u540E\u6CDB\u51FA\u4E91\u7EB9\uFF0C\u5929\u9A6C\u4FBF\u8E29\u7740\u8FD9\u4E9B\u7EB9\u8DEF\u884C\u8D70\uFF0C\u56DB\u8E44\u4ECE\u4E0D\u7740\u5730\u3002\u4F20\u8BF4\u5B83\u4E00\u9E23\uFF0C\u5C71\u4E2D\u79EF\u4E91\u7684\u5F62\u72B6\u5C31\u4F1A\u968F\u4E4B\u6539\u53D8\uFF0C\u6545\u8001\u519C\u770B\u5929\u9A6C\u9E23\u53EB\u7684\u65B9\u4F4D\u6765\u5B9A\u64AD\u79CD\u7684\u65E5\u5B50\u3002"
  Codex: "\u9A6C\u6210\u4E4B\u5C71\u4E0B\u6709\u5EA7\u671B\u4E91\u53F0\u3002\u53F0\u4E0A\u65E0\u7891\uFF0C\u53EA\u523B\u7740\u56DB\u6761\u8E44\u5370\u2014\u2014\u636E\u8BF4\u90A3\u662F\u5929\u9A6C\u7B2C\u4E00\u6B21\u4E5F\u662F\u552F\u4E00\u4E00\u6B21\u843D\u5730\u7684\u8BC1\u636E\u3002"
  TraitName: "\u884C\u7A7A\u8E0F\u4E91"
  TraitDescription: "\u6211\u65B9\u5168\u4F53\u53D7\u5230\u7684\u6CBB\u7597\u4E0E\u62A4\u76FE\u6548\u679C
    +10%\uFF1B\u5965\u4E49\u989D\u5916\u4E3A\u6211\u65B9\u5168\u4F53\u9644\u52A0\u3010\u75BE\u884C\u3011\uFF08\u4E0B\u6B21\u884C\u52A8\u63D0\u524D
    1 \u4F4D\uFF09\u3002"
