  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u897F\u5C71\u7ECF\u300B"
  Quote: "\u53C8\u897F\u4E8C\u767E\u4E8C\u5341\u91CC\uFF0C\u66F0\u4E09\u5371\u4E4B\u5C71\u2026\u2026\u5176\u517D\u591A\u3E32\u725B\u3001\u9EA2\u7F8A\u3001\u8C6A\u5F58\u3002\u8C6A\u5F58\u72B6\u5982\u732A\u800C\u767D\u6BDB\uFF0C\u6BDB\u957F\u6570\u5C3A\uFF0C\u5982\u68D8\u523A\uFF0C\u80FD\u5C04\u4EBA\u3002"
  Lore: "\u4E09\u5371\u4E4B\u5C71\u7684\u98CE\u5927\uFF0C\u8C6A\u5F58\u8D70\u8D77\u8DEF\u6765\u6D51\u8EAB\u68D8\u523A\u5411\u524D\u5012\u4F0F\u3001\u987A\u98CE\u800C\u5367\uFF0C\u8D70\u8D77\u6765\u4FBF\u50CF\u4E00\u7247\u4F1A\u52A8\u7684\u67FD\u67F3\u3002\u5B83\u4ECE\u4E0D\u7528\u523A\u53BB\u653B\u51FB\u2014\u2014\u5B83\u53EA\u662F\u7AD9\u7740\uFF0C\u98CE\u81EA\u5DF1\u4F1A\u66FF\u5B83\u628A\u523A\u9001\u51FA\u53BB\u3002"
  Codex: "\u4E09\u5371\u4E4B\u5C71\u4E0B\u6709\u4EBA\u6361\u5230\u8FC7\u4E00\u6839\u68D8\u523A\uFF0C\u63D2\u5728\u5899\u4E0A\u505A\u9489\u5B50\uFF0C\u7528\u4E86\u4E09\u5341\u5E74\u6CA1\u9508\u3002\u8001\u4EBA\u8BF4\uFF1A\u8C6A\u5F58\u7684\u523A\u4E0D\u662F\u786C\u7684\uFF0C\u662F\u6D3B\u7684\u3002"
  TraitName: "\u68D8\u7532\u53CD\u4F24"
  TraitDescription: "\u81EA\u8EAB\u6BCF\u53D7\u5230\u4E00\u6B21\u8FD1\u6218\u4F24\u5BB3\uFF0C\u53CD\u5F39\u8BE5\u4F24\u5BB3\u7684
    25% \u7ED9\u653B\u51FB\u8005\uFF1B\u62A4\u76FE\u5B58\u5728\u671F\u95F4\u53CD\u5F39\u6BD4\u4F8B\u63D0\u5347\u81F3
    40%\u3002"
