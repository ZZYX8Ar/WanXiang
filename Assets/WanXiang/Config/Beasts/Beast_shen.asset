  Rarity: 2
  Source: "\u300A\u53F2\u8BB0\xB7\u5929\u5B98\u4E66\u300B"
  Quote: "\u6D77\u65C1\u8703\u6C14\u8C61\u697C\u53F0\uFF0C\u5E7F\u91CE\u6C14\u6210\u5BAB\u9619\uFF0C\u7136\u4E91\u6C14\u5404\u8C61\u5176\u5C71\u5DDD\u4EBA\u6C11\u6240\u805A\u79EF\u3002"
  Lore: "\u6D77\u8FB9\u7684\u8001\u6E14\u6C11\u90FD\u77E5\u9053\uFF0C\u8703\u5410\u51FA\u7684\u4E0D\u662F\u96FE\uFF0C\u662F\u8DEF\u3002\u5B83\u8BB0\u5F97\u8FD9\u5EA7\u57CE\u6240\u6709\u7684\u8857\u5DF7\u2014\u2014\u54EA\u5E74\u8C01\u62C6\u4E86\u65E7\u9662\u3001\u54EA\u5E74\u8C01\u8D77\u4E86\u65B0\u697C\uFF0C\u5B83\u90FD\u7167\u7740\u5410\u8FC7\u4E00\u904D\u3002\u6240\u4EE5\u8703\u697C\u91CC\u7684\u57CE\uFF0C\u5F80\u5F80\u6BD4\u5730\u4E0A\u90A3\u5EA7\u8FD8\u5168\u3002"
  Codex: "\u6D77\u8FB9\u7684\u4EBA\u8BF4\uFF0C\u8703\u697C\u91CC\u62DB\u624B\u7684\u90A3\u4E2A\u4EBA\uFF0C\u662F\u5730\u4E0A\u67D0\u4E2A\u4EBA\u6B63\u5728\u60F3\u7684\u6A21\u6837\u3002\u6240\u4EE5\u770B\u89C1\u8703\u697C\u522B\u7B54\u5E94\u2014\u2014\u4F60\u4E0D\u77E5\u9053\u90A3\u662F\u4E0D\u662F\u4F60\u81EA\u5DF1\u5728\u53EB\u4F60\u3002"
  TraitName: "\u8703\u697C\u514D\u63A7"
  TraitDescription: "\u5965\u4E49\u4E3A\u6211\u65B9\u5168\u4F53\u9644\u52A0 1 \u56DE\u5408\u7684\u514D\u63A7\uFF08\u514D\u75AB\u63A7\u5236\u4E0E\u51CF\u901F\uFF09\uFF1B\u6211\u65B9\u5168\u4F53\u53D7\u5230\u7684\u6C34\u5C5E\u6027\u4F24\u5BB3
    -15%\u3002"
