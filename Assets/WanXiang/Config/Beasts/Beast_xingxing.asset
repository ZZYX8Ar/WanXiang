  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u5357\u5C71\u7ECF\u300B"
  Quote: "\u62DB\u6447\u4E4B\u5C71\uFF0C\u6709\u517D\u7109\uFF0C\u5176\u72B6\u5982\u79BA\u800C\u767D\u8033\uFF0C\u4F0F\u884C\u4EBA\u8D70\uFF0C\u5176\u540D\u66F0\u72CC\u72CC\uFF0C\u98DF\u4E4B\u5584\u8D70\u3002"
  Lore: "\u957F\u5F97\u50CF\u733F\uFF0C\u767D\u8272\u8033\u6735\uFF0C\u80FD\u4F0F\u5730\u722C\u884C\u4E5F\u80FD\u76F4\u7ACB\u5954\u8DD1\u3002\u4F20\u8BF4\u5403\u4E86\u5B83\u7684\u8089\u4F1A\u53D8\u5F97\u6781\u5584\u5954\u8D70\u3002\u5B83\u8DD1\u5F97\u5FEB\uFF0C\u662F\u56E0\u4E3A\u5B83\u603B\u5728\u8EB2\u907F\u81EA\u5DF1\u77E5\u9053\u7684\u4E8B\u60C5\u2014\u2014\u72CC\u72CC\u77E5\u5F80\u800C\u4E0D\u77E5\u6765\u3002"
  Codex: "\u5B83\u77E5\u9053\u6240\u6709\u8D70\u8FC7\u7684\u8DEF\uFF0C\u6240\u4EE5\u4ECE\u4E0D\u6562\u56DE\u5934\u770B\u3002"
  TraitName: "\u77E5\u5F80"
  TraitDescription: "\u6218\u6597\u5F00\u59CB\u65F6\uFF0C\u81EA\u8EAB\u901F\u5EA6\u989D\u5916
    +20%\uFF1B\u6BCF\u6B21\u6211\u65B9\u6709\u5355\u4F4D\u9635\u4EA1\uFF0C\u81EA\u8EAB\u901F\u5EA6\u518D
    +10%\uFF08\u65E0\u4E0A\u9650\uFF09\u3002\u81EA\u8EAB\u884C\u52A8\u65F6\u4E0D\u6D88\u8017\u6012\u6C14\u3002"
