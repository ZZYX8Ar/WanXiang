  BeastId: jiuying
  DisplayName: "\u4E5D\u5A74"
  Element: 2
  Role: 3
  Rarity: 3
  Source: "\u300A\u6DEE\u5357\u5B50\xB7\u672C\u7ECF\u8BAD\u300B"
  Quote: "\u902E\u81F3\u5C27\u4E4B\u65F6\uFF0C\u5341\u65E5\u5E76\u51FA\uFF0C\u7126\u79BE\u7A3C\uFF0C\u6740\u8349\u6728\uFF0C\u800C\u6C11\u65E0\u6240\u98DF\u3002\u7330\u8C90\u3001\u51FF\u9F7F\u3001\u4E5D\u5A74\u3001\u5927\u98CE\u3001\u5C01\u8C68\u3001\u4FEE\u86C7\u7686\u4E3A\u6C11\u5BB3\u3002\u5C27\u4E43\u4F7F\u7FBF\u8BDB\u51FF\u9F7F\u4E8E\u7574\u534E\u4E4B\u91CE\uFF0C\u6740\u4E5D\u5A74\u4E8E\u51F6\u6C34\u4E4B\u4E0A\u3002"
  Lore: "\u4E5D\u5A74\u76D8\u8E1E\u5728\u51F6\u6C34\u7684\u4E0A\u6E38\uFF0C\u4E5D\u6761\u9888\u5B50\u5404\u5B88\u4E00\u65B9\uFF0C\u4E5D\u5F20\u5634\u91CC\u542B\u7740\u4E5D\u7C07\u706B\u3002\u5B83\u6BCF\u4E00\u6B21\u540C\u65F6\u5410\u7130\uFF0C\u51F6\u6C34\u7684\u4E0B\u6E38\u5C31\u4F1A\u5E72\u6DB8\u4E00\u6B21\u3002\u5C27\u7684\u7BAD\u6CA1\u80FD\u5C04\u5230\u5B83\u2014\u2014\u5C04\u5230\u5B83\u7684\u662F\u5B83\u81EA\u5DF1\u4E5D\u53E3\u540C\u5578\u65F6\u3001\u4ECE\u4E0A\u6E38\u5012\u704C\u56DE\u6765\u7684\u6C34\u3002"
  Codex: "\u51F6\u6C34\u8FB9\u81F3\u4ECA\u7ACB\u7740\u4E00\u5757\u65E0\u5B57\u7891\u3002\u7ACB\u7891\u7684\u4EBA\u8BF4\uFF1A\u7891\u4E0A\u672C\u6765\u5199\u4E86\u4E5D\u5A74\u7684\u540D\u5B57\uFF0C\u540E\u6765\u88AB\u6C34\u78E8\u5E73\u4E86\u2014\u2014\u8FD9\u5927\u6982\u5C31\u662F\u5B83\u60F3\u8981\u7684\u7ED3\u5C40\u3002"
  TraitName: "\u4E5D\u9996\u540C\u5578"
  TraitDescription: "\u5965\u4E49\u6309\u5B58\u6D3B\u654C\u4EBA\u6570\u8FFD\u52A0\u7B49\u91CF\u7684\u707C\u70E7\u5C42\u6570\uFF08\u76EE\u6807\u8D8A\u591A\u94FA\u5F97\u8D8A\u5E7F\uFF09\uFF1B\u81EA\u8EAB\u6BCF\u6B21\u65BD\u6CD5\u540E\uFF0C\u4E3A\u6211\u65B9\u5168\u4F53\u56DE\u590D
    3% \u751F\u547D\u3002"
