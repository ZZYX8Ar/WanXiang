  Rarity: 2
  Source: "\u300A\u5C14\u96C5\u300B\u9F99\u5B50\u4E5D\u5B50\u4E4B\u4E00"
  Quote: "\u72FB\u730A\uFF0C\u5982\u8666\u732B\uFF0C\u98DF\u864E\u8C79\u3002\u9F99\u751F\u4E5D\u5B50\uFF0C\u5176\u4E94\u66F0\u72FB\u730A\uFF0C\u5F62\u5982\u72EE\uFF0C\u597D\u5750\uFF0C\u53C8\u597D\u70DF\u706B\uFF0C\u6545\u7ACB\u4E8E\u9999\u7089\u4E4B\u4E0A\u3002"
  Lore: "\u72FB\u730A\u662F\u4E5D\u5B50\u4E2D\u6700\u6C89\u5F97\u4F4F\u6C14\u7684\u4E00\u4E2A\u3002\u5B83\u4E0D\u7231\u52A8\uFF0C\u4E5F\u4E0D\u7231\u53EB\uFF0C\u53EA\u80AF\u5B88\u5728\u9999\u7089\u7684\u76D6\u4E0A\uFF0C\u770B\u90A3\u7F15\u70DF\u4E00\u8DEF\u5347\u4E0A\u53BB\u3002\u636E\u8BF4\u70DF\u5347\u5230\u591A\u9AD8\uFF0C\u5B83\u5C31\u80FD\u62A4\u4F4F\u591A\u8FDC\u7684\u5730\u65B9\u3002"
  Codex: "\u8001\u9999\u7089\u4E0A\u7684\u72FB\u730A\u5750\u50CF\uFF0C\u9B03\u6BDB\u523B\u5F97\u683C\u5916\u7EC6\u3002\u5320\u4EBA\u8BF4\u8FD9\u662F\u56E0\u4E3A\u5B83\u4ECE\u4E0D\u52A8\u2014\u2014\u4E0D\u52A8\u7684\u4E1C\u897F\uFF0C\u624D\u914D\u5F97\u4E0A\u523B\u7EC6\u3002"
  TraitName: "\u78D0\u5750\u9547\u5C71"
  TraitDescription: "\u81EA\u8EAB\u751F\u547D\u9AD8\u4E8E 50% \u65F6\uFF0C\u53D7\u5230\u7684\u4F24\u5BB3
    -25%\uFF1B\u4E3A\u6211\u65B9\u5168\u4F53\u9644\u52A0\u62A4\u76FE\u540E\uFF0C\u81EA\u8EAB
    2 \u56DE\u5408\u5185\u51CF\u4F24 15%\u3002"
