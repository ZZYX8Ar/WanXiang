  Quote: "\u9752\u4E18\u4E4B\u5C71\uFF0C\u6709\u9E1F\u7109\uFF0C\u5176\u72B6\u5982\u9E20\uFF0C\u5176\u97F3\u82E5\u5475\uFF0C\u540D\u66F0\u704C\u704C\uFF0C\u4F69\u4E4B\u4E0D\u60D1\u3002"
  Lore: "\u9E20\u5F62\u7684\u5C0F\u9E1F\uFF0C\u9E23\u58F0\u50CF\u4EBA\u5728\u5475\u65A5\u3002\u9752\u4E18\u591A\u5E7B\u672F\uFF0C\u552F\u704C\u704C\u7684\u53EB\u58F0\u80FD\u8BA9\u4EBA\u4ECE\u5E7B\u5883\u4E2D\u6E05\u9192\u2014\u2014\u53E4\u4EBA\u628A\u5B83\u7684\u7FBD\u6BDB\u4F69\u5728\u8EAB\u4E0A\uFF0C\u8BF4\u53EF\u4EE5\u300C\u4E0D\u60D1\u300D\u3002"
  Codex: "\u9752\u4E18\u7684\u96FE\u6563\u4E0D\u5F00\uFF0C\u4F46\u704C\u704C\u4E00\u53EB\uFF0C\u4EBA\u5C31\u77E5\u9053\u81EA\u5DF1\u521A\u521A\u7AD9\u5728\u54EA\u91CC\u3002"
  TraitName: "\u4E0D\u60D1"
  TraitDescription: "\u6211\u65B9\u5168\u4F53\u514D\u75AB\u300C\u6DF7\u4E71\u300D\u4E0E\u300C\u9B45\u60D1\u300D\uFF1B\u6211\u65B9\u5355\u4F4D\u6BCF\u6210\u529F\u62B5\u6297\u4E00\u6B21\u63A7\u5236\uFF0C\u4E3A\u5176\u56DE\u590D
