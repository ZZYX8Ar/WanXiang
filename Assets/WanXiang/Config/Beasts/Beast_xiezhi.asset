  BeastId: xiezhi
  DisplayName: "\u736C\u8C78"
  Element: 4
  Role: 3
  Rarity: 2
  Source: "\u300A\u8BBA\u8861\u300B"
  Quote: "\u736C\u8C78\u8005\uFF0C\u4E00\u89D2\u4E4B\u7F8A\u4E5F\uFF0C\u6027\u77E5\u6709\u7F6A\u3002\u768B\u9676\u6CBB\u72F1\uFF0C\u5176\u7F6A\u7591\u8005\uFF0C\u4EE4\u7F8A\u89E6\u4E4B\uFF1B\u6709\u7F6A\u5219\u89E6\uFF0C\u65E0\u7F6A\u5219\u4E0D\u89E6\u3002"
  Lore: "\u736C\u8C78\u7684\u89D2\u5929\u751F\u7B14\u76F4\uFF0C\u4ECE\u4E0D\u5F2F\u5411\u4EFB\u4F55\u4E00\u8FB9\u3002\u5B83\u4E0D\u8BA4\u5B57\u3001\u4E0D\u8BB0\u540D\uFF0C\u53EA\u8BA4\u6C14\u606F\u2014\u2014\u5FC3\u865A\u7684\u4EBA\u8EAB\u4E0A\u6709\u4E00\u79CD\u5B83\u95FB\u5F97\u51FA\u6765\u7684\u5473\u9053\uFF0C\u6BD4\u4EFB\u4F55\u8BC1\u8BCD\u90FD\u51C6\u3002\u4F20\u8BF4\u5B83\u4E00\u751F\u53EA\u9519\u89E6\u8FC7\u4E00\u6B21\uFF0C\u90A3\u4E00\u591C\u5B83\u81EA\u5DF1\u649E\u6B7B\u5728\u77F3\u4E0A\u3002"
  Codex: "\u53E4\u72F1\u7684\u95E8\u4E0A\u523B\u7740\u736C\u8C78\u3002\u5230\u4E86\u591C\u91CC\uFF0C\u523B\u7EB9\u91CC\u4F1A\u6E17\u51FA\u4E00\u5C42\u8584\u971C\u2014\u2014\u662F\u736C\u8C78\u7684\u89D2\uFF0C\u8FD8\u662F\u72AF\u4EBA\u7684\u6C57\uFF0C\u8C01\u4E5F\u8BF4\u4E0D\u6E05\u3002"
  TraitName: "\u660E\u65AD\u4E0D\u66F2"
  TraitDescription: "\u6218\u8BB0\u547D\u4E2D\u7684\u654C\u4EBA\uFF0C\u5176\u589E\u76CA\u72B6\u6001\u88AB\u7ACB\u5373\u5265\u79BB
    1 \u4E2A\uFF1B\u5BF9\u65E0\u589E\u76CA\u76EE\u6807\u989D\u5916\u9020\u6210 12%
    \u4F24\u5BB3\u3002"
