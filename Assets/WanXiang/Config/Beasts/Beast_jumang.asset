  DisplayName: "\u53E5\u8292"
  Element: 1
  Role: 4
  Rarity: 3
  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u6D77\u5916\u4E1C\u7ECF\u300B"
  Quote: "\u4E1C\u65B9\u53E5\u8292\uFF0C\u9E1F\u8EAB\u4EBA\u9762\uFF0C\u4E58\u4E24\u9F99\u3002"
  Lore: "\u4E1C\u65B9\u4E4B\u795E\uFF0C\u53F8\u6625\u4E0E\u8349\u6728\u3002\u9E1F\u8EAB\u4EBA\u9762\uFF0C\u4E24\u8DB3\u8E0F\u9F99\uFF0C\u6240\u8FC7\u4E4B\u5904\u51BB\u571F\u751F\u82BD\u3002\u4F20\u8BF4\u4ED6\u80FD\u628A\u65AD\u88C2\u7684\u679D\u6761\u63A5\u56DE\u539F\u5904\uFF0C\u4E5F\u80FD\u628A\u5C06\u7184\u7684\u547D\u706B\u91CD\u65B0\u5439\u65FA\u2014\u2014\u4F46\u8FD9\u9700\u8981\u4ED6\u4ED8\u51FA\u81EA\u5DF1\u7684\u5143\u6C14\u3002"
  Codex: "\u7ACB\u6625\u4E4B\u65E5\uFF0C\u4E1C\u98CE\u89E3\u51BB\u3002\u51BB\u571F\u4E4B\u4E0B\u6700\u5148\u9192\u6765\u7684\u4E0D\u662F\u8349\u82BD\uFF0C\u662F\u53E5\u8292\u8E29\u8FC7\u7684\u811A\u5370\u3002"
  TraitName: "\u6625\u751F\u4E0D\u606F"
  TraitDescription: "\u6211\u65B9\u4EFB\u610F\u5355\u4F4D\u9996\u6B21\u9635\u4EA1\u65F6\uFF0C\u4E0D\u8FDB\u5165\u6B7B\u4EA1\u72B6\u6001\uFF0C\u800C\u662F\u4EE5
    40% \u751F\u547D\u590D\u6D3B\u5E76\u9A71\u6563\u5176\u5168\u90E8\u51CF\u76CA\uFF0C\u540C\u65F6\u8BE5\u5355\u4F4D\u83B7\u5F97
    2 \u56DE\u5408\u300C\u65E0\u6211\u300D\uFF08\u514D\u75AB\u6240\u6709\u63A7\u5236\uFF09\u3002\u6BCF\u573A\u6218\u6597\u9650\u89E6\u53D1
    1 \u6B21\u3002"
