  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u4E2D\u5C71\u7ECF\u300B"
  Quote: "\u53C8\u4E1C\u4E8C\u5341\u91CC\uFF0C\u66F0\u82E6\u5C71\u3002\u6709\u517D\u7109\uFF0C\u540D\u66F0\u5C71\u818F\uFF0C\u5176\u72B6\u5982\u9010\uFF0C\u8D64\u82E5\u4E39\u706B\uFF0C\u5584\u8A48\u3002"
  Lore: "\u82E6\u5C71\u6CA1\u6709\u6C34\u6E90\uFF0C\u5C71\u818F\u4FBF\u7528\u53EB\u58F0\u5F15\u6765\u4E91\u3002\u5B83\u55D3\u5B50\u7C97\u3001\u6027\u5B50\u6025\uFF0C\u4E00\u5F00\u53E3\u5C31\u662F\u9A82\u2014\u2014\u5C71\u6C11\u53CD\u800C\u542C\u5F97\u61C2\uFF1A\u5B83\u9A82\u5F97\u8D8A\u51F6\uFF0C\u8BF4\u660E\u4E91\u8D8A\u8FD1\uFF1B\u5B83\u82E5\u662F\u54D1\u4E86\uFF0C\u90A3\u624D\u662F\u771F\u7684\u6CA1\u96E8\u4E86\u3002"
  Codex: "\u82E6\u5C71\u7684\u6751\u53E3\u7ACB\u7740\u4E00\u5757\u77F3\u5934\uFF0C\u77F3\u5934\u4E0A\u51FF\u7740\u4E24\u4E2A\u5B57\uFF1A\u300C\u83AB\u607C\u300D\u3002\u636E\u8BF4\u662F\u6751\u91CC\u8BC6\u5B57\u6700\u591A\u7684\u4EBA\u523B\u7684\uFF0C\u523B\u5B8C\u7B2C\u4E8C\u5E74\uFF0C\u90A3\u5E74\u7684\u6536\u6210\u6700\u597D\u3002"
  TraitName: "\u5B89\u571F\u539A\u517B"
  TraitDescription: "\u5965\u4E49\u7684\u6CBB\u7597\u6539\u4E3A\u6309\u76EE\u6807\u5DF2\u635F\u5931\u751F\u547D\u7684\u6BD4\u4F8B\u56DE\u8840\uFF08\u8D8A\u6B8B\u8840\u56DE\u5F97\u8D8A\u591A\uFF09\uFF1B\u6CBB\u7597\u65F6\u989D\u5916\u9A71\u6563
    1 \u4E2A\u51CF\u76CA\u3002"
