  Source: "\u300A\u4E91\u7B08\u4E03\u7B7E\xB7\u8F69\u8F95\u672C\u7EAA\u300B"
  Quote: "\u9EC4\u5E1D\u4E1C\u5DE1\u81F3\u6D77\uFF0C\u767B\u6853\u5C71\uFF0C\u4E8E\u6D77\u6EE8\u5F97\u767D\u6CFD\u795E\u517D\uFF0C\u80FD\u8A00\uFF0C\u8FBE\u4E8E\u4E07\u7269\u4E4B\u60C5\u3002\u2026\u2026\u51E1\u4E00\u5343\u4E94\u767E\u4E8C\u5341\u79CD\u3002"
  Lore: "\u80FD\u8BF4\u8BDD\uFF0C\u901A\u6653\u4E07\u7269\u4E4B\u60C5\u3002\u9EC4\u5E1D\u4E1C\u5DE1\u65F6\u5728\u6D77\u8FB9\u9047\u5230\u5B83\uFF0C\u95EE\u5929\u4E0B\u9B3C\u795E\u4E4B\u4E8B\uFF0C\u5B83\u7B54\u4E86\u4E00\u4E07\u4E00\u5343\u4E94\u767E\u4E8C\u5341\u79CD\u3002\u4F20\u8BF4\u300A\u767D\u6CFD\u56FE\u300B\u4FBF\u662F\u7531\u6B64\u800C\u6765\u2014\u2014\u4E00\u672C\u8BB0\u5F55\u6240\u6709\u602A\u7269\u5F31\u70B9\u7684\u624B\u518C\u3002"
  Codex: "\u5B83\u77E5\u9053\u4E00\u4E07\u4E00\u5343\u4E94\u767E\u4E8C\u5341\u79CD\u9B3C\uFF0C\u6240\u4EE5\u5B83\u4ECE\u4E0D\u5BB3\u6015\u4EFB\u4F55\u4E00\u4E2A\u3002"
  TraitName: "\u8FBE\u4E07\u7269\u4E4B\u60C5"
  TraitDescription: "\u6218\u6597\u5F00\u59CB\u65F6\uFF0C\u63ED\u9732\u654C\u65B9\u5168\u4F53\u7684\u4E94\u884C\u5C5E\u6027\u3001\u643A\u5E26\u6280\u80FD\u4E0E\u5F31\u70B9\uFF08\u73A9\u5BB6\u53EF\u89C1\uFF09\uFF1B\u6211\u65B9\u5168\u4F53\u5BF9\u300C\u5DF2\u63ED\u9732\u300D\u7684\u654C\u4EBA\u9020\u6210\u7684\u4F24\u5BB3
    +12%\u3002\u6211\u65B9\u5355\u4F4D\u6BCF\u6B21\u66B4\u51FB\uFF0C\u5168\u961F\u83B7\u5F97
    1 \u5C42\u300C\u77E5\u300D\uFF08\u66B4\u51FB\u7387 +3%\uFF0C\u4E0A\u9650 8 \u5C42\uFF09\u3002"
