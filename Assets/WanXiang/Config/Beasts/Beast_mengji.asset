  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u5317\u5C71\u7ECF\u300B"
  Quote: "\u53C8\u5317\u4E8C\u767E\u516B\u5341\u91CC\uFF0C\u66F0\u77F3\u8005\u4E4B\u5C71\uFF0C\u65E0\u8349\u6728\uFF0C\u591A\u7476\u78A7\u3002\u6EF1\u6C34\u51FA\u4E8E\u5176\u9633\uFF0C\u800C\u4E1C\u6D41\u6CE8\u4E8E\u7EF3\u6C34\u3002\u6709\u517D\u7109\uFF0C\u5176\u72B6\u5982\u8C79\uFF0C\u800C\u6587\u9898\u767D\u8EAB\uFF0C\u540D\u66F0\u5B5F\u6781\uFF0C\u5584\u4F0F\u3002"
  Lore: "\u77F3\u8005\u4E4B\u5C71\u4E0A\u6CA1\u6709\u8349\u6728\uFF0C\u53EA\u6709\u7476\u7389\u4E0E\u78A7\u77F3\u3002\u5B5F\u6781\u751F\u4E8E\u6B64\u95F4\u7684\u88C2\u9699\u91CC\uFF0C\u76AE\u6BDB\u56E0\u5E38\u5E74\u4F0F\u5730\u800C\u78E8\u5F97\u8584\u800C\u4EAE\u3002\u5B83\u4E0D\u52A8\u65F6\u4E0E\u5C71\u77F3\u65E0\u5F02\uFF0C\u52A8\u65F6\u53EA\u5269\u4E00\u9053\u9752\u5F71\u2014\u2014\u5C71\u6C11\u8BF4\uFF0C\u770B\u89C1\u5B5F\u6781\u7684\u90A3\u4E00\u523B\uFF0C\u5B83\u5DF2\u7ECF\u8FC7\u53BB\u4E86\u3002"
  Codex: "\u77F3\u8005\u4E4B\u5C71\u7684\u6A35\u592B\u6709\u4E2A\u4E60\u60EF\uFF1A\u4E0A\u5C71\u5148\u6572\u4E09\u4E0B\u77F3\u58C1\u3002\u5C45\u5C71\u56DB\u5341\u5E74\u7684\u4EBA\u8BF4\uFF0C\u6572\u54CD\u7684\u7B2C\u4E00\u58F0\u662F\u7ED9\u81EA\u5DF1\u58EE\u80C6\uFF0C\u7B2C\u4E8C\u58F0\u662F\u7ED9\u540C\u4F34\u62A5\u4FE1\uFF0C\u7B2C\u4E09\u58F0\u2014\u2014\u662F\u8BF7\u5B5F\u6781\u5148\u8D70\u3002"
  TraitName: "\u4F0F\u5F71\u65E0\u75D5"
  TraitDescription: "\u81EA\u8EAB\u901F\u5EA6 +12%\uFF1B\u666E\u653B\u547D\u4E2D\u7684\u76EE\u6807\u82E5\u80FD\u8FFD\u51FB\uFF0C\u5219\u672C\u56DE\u5408\u989D\u5916\u9644\u52A0\u4E00\u6B21
    40% \u7684\u666E\u653B\uFF08\u6BCF\u56DE\u5408\u6700\u591A 1 \u6B21\uFF09\u3002"
