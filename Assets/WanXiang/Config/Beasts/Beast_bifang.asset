  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u897F\u5C71\u7ECF\u300B"
  Quote: "\u7AE0\u83AA\u4E4B\u5C71\uFF0C\u6709\u9E1F\u7109\uFF0C\u5176\u72B6\u5982\u9E64\uFF0C\u4E00\u8DB3\uFF0C\u8D64\u6587\u9752\u8D28\u800C\u767D\u5599\uFF0C\u540D\u66F0\u6BD5\u65B9\uFF0C\u5176\u9E23\u81EA\u53EB\u4E5F\uFF0C\u89C1\u5219\u5176\u9091\u6709\u8BB9\u706B\u3002"
  Lore: "\u9E64\u5F62\u72EC\u8DB3\u4E4B\u9E1F\uFF0C\u9752\u5E95\u7EA2\u82B1\uFF0C\u767D\u5599\u3002\u5B83\u51FA\u73B0\u7684\u5730\u65B9\u4F1A\u83AB\u540D\u5176\u5999\u5730\u8D77\u706B\u2014\u2014\u4E0D\u662F\u5B83\u7EB5\u706B\uFF0C\u800C\u662F\u5B83\u672C\u8EAB\u5C31\u662F\u4E00\u5EA7\u884C\u8D70\u7684\u5F15\u4FE1\u3002\u53E4\u4EBA\u8BA8\u538C\u5B83\uFF0C\u56E0\u4E3A\u5B83\u603B\u80FD\u63D0\u524D\u77E5\u9053\u54EA\u91CC\u8981\u7740\u706B\u3002"
  Codex: "\u5B83\u53EB\u7684\u65F6\u5019\uFF0C\u5C4B\u5B50\u5DF2\u7ECF\u5728\u5192\u70DF\u4E86\u3002"
  TraitName: "\u8BB9\u706B"
  TraitDescription: "\u6211\u65B9\u706B\u5C5E\u6027\u5355\u4F4D\u9020\u6210\u4F24\u5BB3\u65F6\uFF0C\u6709
