  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u6D77\u5916\u5317\u7ECF\u300B"
  Quote: "\u5317\u65B9\u79BA\u5F3A\uFF0C\u4EBA\u9762\u9E1F\u8EAB\uFF0C\u73E5\u4E24\u9752\u86C7\uFF0C\u8DF5\u4E24\u8D64\u86C7\u3002"
  Lore: "\u5317\u65B9\u4E4B\u795E\uFF0C\u4EA6\u79F0\u7384\u51A5\uFF0C\u4EBA\u9762\u9E1F\u8EAB\uFF0C\u4E24\u8033\u6302\u9752\u86C7\uFF0C\u4E24\u811A\u8E0F\u8D64\u86C7\u3002\u4ED6\u638C\u7BA1\u51AC\u4E0E\u5BD2\uFF0C\u4E5F\u638C\u7BA1\u5317\u65B9\u7684\u98CE\u2014\u2014\u5728\u4ED6\u811A\u4E0B\uFF0C\u6C34\u4F1A\u81EA\u5DF1\u7ED3\u6210\u51B0\u3002"
  Codex: "\u4ED6\u4E0D\u9700\u8981\u52A8\u624B\uFF0C\u5317\u98CE\u4F1A\u66FF\u4ED6\u505A\u5B8C\u5269\u4E0B\u7684\u4E8B\u3002"
  TraitName: "\u7384\u51A5"
  TraitDescription: "\u6218\u6597\u5F00\u59CB\u65F6\uFF0C\u654C\u65B9\u5168\u4F53\u7684\u901F\u5EA6\u6309\u5F53\u524D\u8282\u6C14\u964D\u5E8F\u6392\u5217\u5E76\u6807\u8BB0\u4E3A\u884C\u52A8\u5E8F\u5217\uFF08\u73A9\u5BB6\u53EF\u89C1\uFF09\uFF1B\u654C\u65B9\u6BCF\u6709\u4E00\u4E2A\u5355\u4F4D\u88AB\u51BB\u7ED3\uFF0C\u6211\u65B9\u5168\u4F53\u653B\u51FB
    +6%\uFF08\u53EF\u53E0\u52A0\uFF09\u3002"
