  Quote: "\u7AE0\u5C3E\u5C71\uFF0C\u6709\u795E\uFF0C\u4EBA\u9762\u86C7\u8EAB\u800C\u8D64\uFF0C\u76F4\u76EE\u6B63\u4E58\uFF0C\u5176\u7791\u4E43\u6666\uFF0C\u5176\u89C6\u4E43\u660E\uFF0C\u4E0D\u98DF\u4E0D\u5BDD\u4E0D\u606F\uFF0C\u98CE\u96E8\u662F\u8C12\u3002\u662F\u70DB\u4E5D\u9634\uFF0C\u662F\u8C13\u70DB\u9F99\u3002"
  Lore: "\u4EBA\u9762\u86C7\u8EAB\uFF0C\u901A\u4F53\u8D64\u7EA2\uFF0C\u8EAB\u957F\u5343\u91CC\u3002\u5B83\u95ED\u4E0A\u773C\u775B\u5C31\u662F\u9ED1\u591C\uFF0C\u7741\u5F00\u773C\u775B\u5C31\u662F\u767D\u5929\u3002\u4E0D\u5403\u4E0D\u7761\u4E0D\u547C\u5438\uFF0C\u4E00\u547C\u4E00\u5438\u4E4B\u95F4\u4FBF\u662F\u98CE\u4E0E\u96E8\u3002\u5B83\u4E0D\u662F\u795E\uFF0C\u5B83\u662F\u663C\u591C\u672C\u8EAB\u3002"
  Codex: "\u5B83\u7741\u773C\u7684\u65F6\u5019\uFF0C\u8BF7\u4E0D\u8981\u76F4\u89C6\u3002"
  TraitName: "\u53F8\u663C\u591C"
  TraitDescription: "\u6218\u6597\u5728\u7B2C 1 \u56DE\u5408\u5F00\u59CB\u65F6\u8FDB\u5165\u300C\u663C\u300D\u72B6\u6001\uFF0C\u7B2C
