  BeastId: changyou
  DisplayName: "\u957F\u53F3"
  Element: 3
  Role: 5
  Rarity: 2
  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u5357\u5C71\u7ECF\u300B"
  Quote: "\u4E1C\u5357\u56DB\u767E\u4E94\u5341\u91CC\uFF0C\u66F0\u957F\u53F3\u4E4B\u5C71\uFF0C\u65E0\u8349\u6728\uFF0C\u591A\u6C34\u3002\u6709\u517D\u7109\uFF0C\u5176\u72B6\u5982\u79BA\u800C\u56DB\u8033\uFF0C\u5176\u540D\u957F\u53F3\uFF0C\u5176\u97F3\u5982\u541F\uFF0C\u89C1\u5219\u90E1\u53BF\u5927\u6C34\u3002"
  Lore: "\u957F\u53F3\u4E4B\u5C71\u7684\u56DB\u6761\u8033\u6735\u5206\u522B\u542C\u7740\u56DB\u65B9\u6C34\u8109\u3002\u5B83\u4E00\u5F00\u53E3\u541F\uFF0C\u5C71\u4E0B\u7684\u6EAA\u5C31\u8981\u6DA8\uFF1B\u5B83\u82E5\u662F\u8FDE\u541F\u4E09\u591C\uFF0C\u90E1\u53BF\u5C31\u8981\u8FC1\u4EBA\u3002\u5F53\u5730\u4EBA\u542C\u89C1\u8FD9\u58F0\u541F\uFF0C\u4E0D\u8DD1\uFF0C\u53EA\u662F\u628A\u6C34\u7F38\u642C\u5230\u9AD8\u5904\u3002"
  Codex: "\u957F\u53F3\u5C71\u7684\u730E\u6237\u8BF4\uFF0C\u957F\u53F3\u5176\u5B9E\u4E0D\u4F1A\u6C34\u3002\u5B83\u56DB\u53EA\u8033\u6735\u542C\u4E86\u4E00\u8F88\u5B50\u7684\u6C34\u58F0\uFF0C\u81EA\u5DF1\u5374\u4ECE\u6CA1\u4E0B\u8FC7\u6C34\u2014\u2014\u5B83\u6015\u7684\uFF0C\u5C31\u662F\u5B83\u4E00\u76F4\u5728\u9884\u544A\u7684\u90A3\u4EF6\u4E8B\u3002"
  TraitName: "\u5148\u89C9\u56DB\u8033"
  TraitDescription: "\u6218\u6597\u7B2C 1 \u56DE\u5408\u8D77\uFF0C\u81EA\u8EAB\u884C\u52A8\u987A\u5E8F\u59CB\u7EC8\u4F18\u5148\u4E8E\u654C\u65B9\u540C\u901F\u5355\u4F4D\uFF1B\u9884\u611F\u5230\u5371\u9669\u65F6\uFF0C\u672C\u56DE\u5408\u884C\u52A8\u6761\u524D\u8FDB
    20%\u3002"
