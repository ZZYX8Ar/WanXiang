  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u897F\u5C71\u7ECF\u300B"
  Quote: "\u6606\u4ED1\u4E4B\u4E18\uFF0C\u662F\u5B9E\u60DF\u5E1D\u4E4B\u4E0B\u90FD\uFF0C\u795E\u9646\u543E\u53F8\u4E4B\u3002\u5176\u795E\u72B6\u864E\u8EAB\u800C\u4E5D\u5C3E\uFF0C\u4EBA\u9762\u800C\u864E\u722A\uFF0C\u662F\u795E\u4E5F\uFF0C\u53F8\u5929\u4E4B\u4E5D\u90E8\u53CA\u5E1D\u4E4B\u56FF\u65F6\u3002"
  Lore: "\u864E\u8EAB\u4E5D\u5C3E\uFF0C\u4EBA\u9762\u864E\u722A\u3002\u6606\u4ED1\u662F\u5929\u5E1D\u5728\u4EBA\u95F4\u7684\u90FD\u57CE\uFF0C\u800C\u9646\u543E\u662F\u5B83\u7684\u5B88\u95E8\u4EBA\u2014\u2014\u4ED6\u638C\u7BA1\u7684\u4E0D\u662F\u6218\u6597\uFF0C\u662F\u300C\u754C\u9650\u300D\u3002\u4ED6\u4E0D\u5141\u8BB8\u4E0D\u8BE5\u8FDB\u6765\u7684\u4E1C\u897F\u8FDB\u6765\u3002"
  Codex: "\u6606\u4ED1\u4E0D\u662F\u4E0D\u8BA9\u4EBA\u8FDB\uFF0C\u662F\u9646\u543E\u89C9\u5F97\u4F60\u8FD8\u6CA1\u51C6\u5907\u597D\u3002"
  TraitName: "\u53F8\u754C"
  TraitDescription: "\u6211\u65B9\u7AD9\u4F4D\u5728\u524D\u6392\uFF08\u7B2C 1 \u884C\uFF09\u7684\u5355\u4F4D\u53D7\u5230\u7684\u4F24\u5BB3\u964D\u4F4E
    20%\uFF1B\u654C\u65B9\u5355\u4F4D\u65E0\u6CD5\u7A7F\u8FC7\u6211\u65B9\u524D\u6392\u653B\u51FB\u540E\u6392\uFF08\u65E0\u4F4D\u79FB\u7C7B\u6280\u80FD\u65F6\uFF09\u3002"
