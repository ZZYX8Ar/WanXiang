  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u897F\u5C71\u7ECF\u300B"
  Quote: "\u7AE0\u83AA\u4E4B\u5C71\uFF0C\u6709\u517D\u7109\uFF0C\u5176\u72B6\u5982\u8D64\u8C79\uFF0C\u4E94\u5C3E\u4E00\u89D2\uFF0C\u5176\u97F3\u5982\u51FB\u77F3\uFF0C\u5176\u540D\u66F0\u72F0\u3002"
  Lore: "\u8D64\u8272\u8C79\u8EAB\uFF0C\u4E94\u6761\u5C3E\u5DF4\uFF0C\u5934\u4E0A\u4E00\u53EA\u89D2\uFF0C\u53EB\u58F0\u50CF\u6572\u77F3\u5934\u3002\u5B83\u8DD1\u8D77\u6765\u7684\u65F6\u5019\uFF0C\u4E94\u6761\u5C3E\u5DF4\u4F1A\u5728\u8EAB\u540E\u626B\u51FA\u4E00\u9053\u5149\u3002"
  Codex: "\u4E94\u6761\u5C3E\u5DF4\u626B\u8FC7\u53BB\uFF0C\u77F3\u5934\u5C31\u771F\u7684\u662F\u77F3\u5934\u58F0\u4E86\u3002"
  TraitName: "\u4E94\u5C3E"
  TraitDescription: "\u81EA\u8EAB\u666E\u653B\u6539\u4E3A\u5BF9\u968F\u673A\u654C\u4EBA\u53D1\u52A8
    5 \u6BB5\u653B\u51FB\uFF08\u6BCF\u6BB5 35% \u653B\u51FB\uFF09\uFF1B\u6BCF\u6BB5\u547D\u4E2D\u72EC\u7ACB\u5224\u5B9A\u66B4\u51FB\uFF0C\u4EFB\u610F\u4E00\u6BB5\u66B4\u51FB\u5219\u4E0B\u4E00\u6BB5\u4F24\u5BB3
    +25%\uFF08\u53EF\u7D2F\u4E58\uFF09\u3002"
