  Quote: "\u6556\u5CB8\u4E4B\u5C71\uFF0C\u2026\u2026\u6709\u517D\u7109\uFF0C\u5176\u72B6\u5982\u767D\u9E7F\u800C\u56DB\u89D2\uFF0C\u540D\u66F0\u592B\u8BF8\uFF0C\u89C1\u5219\u5176\u9091\u5927\u6C34\u3002"
  Lore: "\u767D\u9E7F\u800C\u6709\u56DB\u89D2\u3002\u5B83\u662F\u6E29\u67D4\u7684\u795E\u517D\uFF0C\u51FA\u73B0\u7684\u5730\u65B9\u5374\u603B\u8981\u53D1\u5927\u6C34\u3002\u53E4\u4EBA\u628A\u5B83\u5F52\u5165\u300C\u51F6\u5146\u300D\uFF0C\u5176\u5B9E\u5B83\u53EA\u662F\u6C34\u7684\u4FE1\u4F7F\u2014\u2014\u5B83\u6765\u4E86\uFF0C\u8BF4\u660E\u6C34\u5DF2\u7ECF\u5728\u8DEF\u4E0A\u4E86\u3002"
  Codex: "\u5B83\u6CA1\u6709\u6076\u610F\u3002\u6C34\u4E5F\u6CA1\u6709\u3002"
  TraitName: "\u89C1\u5219\u5927\u6C34"
  TraitDescription: "\u6218\u6597\u5F00\u59CB\u65F6\uFF0C\u4E3A\u5168\u573A\u6DFB\u52A0
