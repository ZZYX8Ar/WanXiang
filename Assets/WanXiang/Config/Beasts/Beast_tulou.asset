  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u897F\u5C71\u7ECF\u300B"
  Quote: "\u53C8\u897F\u4E8C\u767E\u91CC\uFF0C\u66F0\u6606\u4ED1\u4E4B\u4E18\u2026\u2026\u6709\u517D\u7109\uFF0C\u5176\u72B6\u5982\u7F8A\u800C\u56DB\u89D2\uFF0C\u540D\u66F0\u571F\u877C\uFF0C\u662F\u98DF\u4EBA\u3002"
  Lore: "\u6606\u4ED1\u4E4B\u4E18\u7684\u5761\u4E0A\u5BF8\u8349\u7686\u786C\u5982\u94C1\uFF0C\u571F\u877C\u7684\u8E44\u4FBF\u957F\u5F97\u50CF\u67F1\u5B50\u4E00\u6837\u5BBD\u3002\u5B83\u56DB\u89D2\u5916\u5377\uFF0C\u4E0D\u662F\u4E3A\u4E86\u9876\uFF0C\u662F\u4E3A\u4E86\u64AC\u2014\u2014\u6606\u4ED1\u7684\u5CA9\u77F3\u5728\u5B83\u89D2\u4E0B\uFF0C\u7FFB\u5F00\u5C31\u50CF\u7FFB\u5F00\u4E00\u5C42\u8584\u571F\u3002"
  Codex: "\u6606\u4ED1\u7684\u76D7\u7389\u4EBA\u6709\u4E2A\u89C4\u77E9\uFF1A\u89C1\u571F\u877C\u5148\u6254\u77F3\u5934\u3002\u6254\u51FA\u53BB\u7684\u77F3\u5934\u5B83\u4E00\u5B9A\u4F1A\u8FFD\u2014\u2014\u5B83\u6709\u89D2\u6CA1\u773C\uFF0C\u8FFD\u7684\u4ECE\u6765\u4E0D\u662F\u4EBA\u3002"
  TraitName: "\u88C2\u5730\u56DB\u89D2"
  TraitDescription: "\u5965\u4E49\u5BF9\u524D\u6392\u76EE\u6807\u989D\u5916\u9020\u6210\u5176\u6700\u5927\u751F\u547D
    8% \u7684\u771F\u5B9E\u4F24\u5BB3\uFF1B\u81EA\u8EAB\u9632\u5FA1 +15%\u3002"
