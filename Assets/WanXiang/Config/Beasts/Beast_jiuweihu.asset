  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u5357\u5C71\u7ECF\u300B"
  Quote: "\u9752\u4E18\u4E4B\u5C71\uFF0C\u6709\u517D\u7109\uFF0C\u5176\u72B6\u5982\u72D0\u800C\u4E5D\u5C3E\uFF0C\u5176\u97F3\u5982\u5A74\u513F\uFF0C\u80FD\u98DF\u4EBA\uFF0C\u98DF\u8005\u4E0D\u86CA\u3002"
  Lore: "\u9752\u4E18\u4E4B\u5C71\u7684\u4E3B\u4EBA\u3002\u4E5D\u6761\u5C3E\u5E76\u975E\u88C5\u9970\u2014\u2014\u6BCF\u4E00\u6761\u5C3E\u90FD\u662F\u4E00\u4E16\u4FEE\u884C\uFF0C\u5C3E\u5DF4\u8D8A\u591A\uFF0C\u80FD\u8C03\u52A8\u7684\u300C\u60D1\u300D\u5C31\u8D8A\u6D53\u3002\u5B83\u7684\u58F0\u97F3\u50CF\u5A74\u513F\u557C\u54ED\uFF0C\u542C\u89C1\u7684\u4EBA\u4F1A\u4E0D\u7531\u81EA\u4E3B\u5730\u5F80\u524D\u8D70\u3002"
  Codex: "\u4E5D\u5C3E\u4E0D\u662F\u6218\u529B\uFF0C\u662F\u4E5D\u4E16\u7684\u8010\u5FC3\u3002\u5B83\u4ECE\u4E0D\u7740\u6025\uFF0C\u6025\u7684\u662F\u8D70\u8FDB\u9752\u4E18\u7684\u4EBA\u3002"
  TraitName: "\u4E5D\u5C3E\u9012\u8FDB"
  TraitDescription: "\u6BCF\u56DE\u5408\u5F00\u59CB\u65F6\uFF0C\u81EA\u8EAB\u83B7\u5F97
    1 \u5C42\u300C\u5C3E\u300D\uFF08\u4E0A\u9650 9 \u5C42\uFF09\u3002\u6BCF\u5C42\u4F7F\u666E\u653B\u989D\u5916\u9644\u52A0\u4E00\u6BB5
    12% \u653B\u51FB\u7684\u4F24\u5BB3\u3002\u53D7\u5230\u81F4\u547D\u4F24\u5BB3\u65F6\uFF0C\u6D88\u8017\u5168\u90E8\u5C42\u6570\uFF0C\u6BCF\u5C42\u56DE\u590D
    8% \u6700\u5927\u751F\u547D\u3002"
