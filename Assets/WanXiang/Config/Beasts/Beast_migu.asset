  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u5357\u5C71\u7ECF\u300B"
  Quote: "\u62DB\u6447\u4E4B\u5C71\uFF0C\u6709\u6728\u7109\uFF0C\u5176\u72B6\u5982\u6996\u800C\u9ED1\u7406\uFF0C\u5176\u534E\u56DB\u7167\uFF0C\u5176\u540D\u66F0\u8FF7\u6996\uFF0C\u4F69\u4E4B\u4E0D\u8FF7\u3002"
  Lore: "\u5E76\u975E\u517D\uFF0C\u800C\u662F\u62DB\u6447\u5C71\u4E0A\u7684\u4E00\u682A\u795E\u6728\u3002\u6811\u76AE\u6709\u9ED1\u8272\u7EB9\u7406\uFF0C\u5F00\u82B1\u65F6\u5149\u7167\u56DB\u65B9\u3002\u6298\u4E00\u679D\u5E26\u5728\u8EAB\u4E0A\uFF0C\u5C31\u6C38\u8FDC\u4E0D\u4F1A\u5728\u5C71\u91CC\u8FF7\u8DEF\u3002\u6B64\u5904\u7684\u8FF7\u6996\uFF0C\u662F\u5B83\u5316\u5F62\u800C\u51FA\u7684\u6728\u7075\u3002"
  Codex: "\u62DB\u6447\u5C71\u4E0A\u6CA1\u6709\u8DEF\uFF0C\u53EA\u6709\u8FF7\u6996\u3002\u627E\u5230\u5B83\u7684\u4EBA\uFF0C\u4ECE\u6B64\u518D\u6CA1\u4E22\u8FC7\u65B9\u5411\u3002"
  TraitName: "\u4E0D\u8FF7"
  TraitDescription: "\u81EA\u8EAB\u514D\u75AB\u300C\u653E\u9010\u300D\u300C\u4F20\u9001\u6539\u4F4D\u300D\u7C7B\u6548\u679C\uFF1B\u6211\u65B9\u5355\u4F4D\u4E0D\u4F1A\u88AB\u5F3A\u5236\u6539\u53D8\u7AD9\u4F4D\u3002\u53D7\u5230\u653B\u51FB\u65F6\uFF0C\u4E3A\u653B\u51FB\u8005\u9644\u52A0
    1 \u5C42\u300C\u8FF7\u300D\uFF08\u547D\u4E2D -10%\uFF0C\u53EF\u53E0 3 \u5C42\uFF09\u3002"
