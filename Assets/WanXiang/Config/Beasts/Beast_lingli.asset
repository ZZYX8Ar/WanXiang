  BeastId: lingli
  DisplayName: "\u9675\u9CA4"
  Element: 5
  Role: 1
  Rarity: 1
  Source: "\u300A\u672C\u8349\u7EB2\u76EE\u300B"
  Quote: "\u9CAE\u9CA4\uFF0C\u72B6\u5982\u9F0D\u800C\u5C0F\uFF0C\u80CC\u5982\u9CA4\u800C\u9614\uFF0C\u9996\u5982\u9F20\u800C\u65E0\u7259\uFF0C\u8179\u65E0\u9CDE\u800C\u6709\u6BDB\uFF0C\u957F\u820C\u5C16\u5599\uFF0C\u5C3E\u4E0E\u8EAB\u7B49\u3002\u5C3E\u9CDE\u5C16\u539A\uFF0C\u6709\u4E09\u89D2\uFF0C\u7528\u7A7F\u7A74\uFF0C\u6545\u66F0\u9CAE\u9CA4\u3002"
  Lore: "\u9675\u9CA4\u7684\u7532\u7247\u4ECE\u9888\u4E00\u76F4\u6392\u5230\u5C3E\u5C16\uFF0C\u6BCF\u4E00\u7247\u90FD\u78E8\u5F97\u53D1\u4EAE\u2014\u2014\u4E0D\u662F\u5728\u77F3\u4E0A\u78E8\u7684\uFF0C\u662F\u5728\u5B83\u81EA\u5DF1\u94BB\u8FC7\u7684\u571F\u91CC\u78E8\u7684\u3002\u5B83\u4E00\u751F\u8D70\u8FC7\u7684\u5730\u65B9\uFF0C\u5730\u4E0A\u90FD\u4F1A\u7559\u4E0B\u4E00\u9053\u7EC6\u957F\u7684\u6C9F\u3002"
  Codex: "\u5C71\u91CC\u7684\u8001\u4EBA\u8BF4\uFF0C\u9675\u9CA4\u94BB\u8FC7\u7684\u571F\u6700\u677E\uFF0C\u6765\u5E74\u63D2\u79E7\u6700\u597D\u6D3B\u3002\u6240\u4EE5\u89C1\u4E86\u90A3\u9053\u6C9F\uFF0C\u4E0D\u8981\u586B\u2014\u2014\u90A3\u662F\u5B83\u66FF\u4F60\u7FFB\u8FC7\u7684\u4E00\u5757\u5730\u3002"
  TraitName: "\u7A7F\u5C71\u7834\u7532"
  TraitDescription: "\u81EA\u8EAB\u666E\u653B\u65E0\u89C6\u76EE\u6807 50% \u62A4\u76FE\uFF1B\u4E3A\u6211\u65B9\u5168\u4F53\u9644\u52A0\u62A4\u76FE\u540E\uFF0C\u62A4\u76FE\u503C\u989D\u5916
    +15%\u3002"
