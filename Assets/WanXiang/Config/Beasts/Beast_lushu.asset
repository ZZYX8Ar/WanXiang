  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u5357\u5C71\u7ECF\u300B"
  Quote: "\u677B\u9633\u4E4B\u5C71\uFF0C\u6709\u517D\u7109\uFF0C\u5176\u72B6\u5982\u9A6C\u800C\u767D\u9996\uFF0C\u5176\u6587\u5982\u864E\u800C\u8D64\u5C3E\uFF0C\u5176\u97F3\u5982\u8C23\uFF0C\u5176\u540D\u66F0\u9E7F\u8700\uFF0C\u4F69\u4E4B\u5B9C\u5B50\u5B59\u3002"
  Lore: "\u9A6C\u8EAB\u767D\u9996\uFF0C\u8EAB\u6709\u864E\u7EB9\uFF0C\u62D6\u7740\u4E00\u6761\u8D64\u7EA2\u7684\u5C3E\u3002\u5B83\u4E0D\u4F24\u4EBA\uFF0C\u53EA\u662F\u7AD9\u7740\u5531\u6B4C\uFF0C\u6B4C\u58F0\u50CF\u6C11\u8C23\u4E00\u6837\u597D\u542C\u3002\u53E4\u4EBA\u4F69\u5B83\u7684\u6BDB\u53D1\uFF0C\u8BF4\u80FD\u4FDD\u4F51\u5B50\u55E3\u7E41\u884D\u2014\u2014\u5728\u672C\u4F5C\u91CC\uFF0C\u5B83\u4FDD\u4F51\u7684\u662F\u961F\u4F0D\u7684\u5EF6\u7EED\u3002"
  Codex: "\u5B83\u5531\u6B4C\u7684\u65F6\u5019\uFF0C\u6574\u5EA7\u677B\u9633\u5C71\u90FD\u5728\u7167\u6599\u540E\u4EE3\u3002"
  TraitName: "\u5B9C\u5B50\u5B59"
  TraitDescription: "\u6211\u65B9\u7684\u6CBB\u7597\u4E0E\u62A4\u76FE\u6548\u679C\u6EA2\u51FA\u65F6\uFF0C\u6EA2\u51FA\u91CF\u7684
    40% \u4F1A\u8F6C\u79FB\u7ED9\u751F\u547D\u6700\u4F4E\u7684\u53E6\u4E00\u540D\u961F\u53CB\uFF08\u53EF\u8FDE\u9501
    1 \u6B21\uFF09\u3002"
