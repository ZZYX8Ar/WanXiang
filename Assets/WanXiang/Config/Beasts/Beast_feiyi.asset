  Source: "\u300A\u5C71\u6D77\u7ECF\xB7\u897F\u5C71\u7ECF\u300B"
  Quote: "\u592A\u534E\u4E4B\u5C71\uFF0C\u6709\u86C7\u7109\uFF0C\u540D\u66F0\u80A5\u9057\uFF0C\u516D\u8DB3\u56DB\u7FFC\uFF0C\u89C1\u5219\u5929\u4E0B\u5927\u65F1\u3002"
  Lore: "\u86C7\u8EAB\u800C\u6709\u516D\u8DB3\u56DB\u7FFC\uFF0C\u98DE\u4E0D\u8D77\u6765\u4F46\u722C\u5F97\u6781\u5FEB\u3002\u5B83\u51FA\u73B0\u7684\u5E74\u4EFD\u5FC5\u6709\u5927\u65F1\u3002\u5728\u672C\u4F5C\u91CC\uFF0C\u5B83\u662F\u300C\u65F1\u300D\u7684\u5316\u5F62\u2014\u2014\u5B83\u6240\u5728\u4E4B\u5904\uFF0C\u6C34\u4F1A\u81EA\u5DF1\u79BB\u5F00\u3002"
  Codex: "\u5B83\u722C\u8FC7\u7684\u5730\u65B9\uFF0C\u571F\u6BD4\u77F3\u5934\u8FD8\u5E72\u3002"
  TraitName: "\u5927\u65F1"
  TraitDescription: "\u81EA\u8EAB\u83B7\u53D6\u6012\u6C14\u901F\u5EA6 +40%\uFF1B\u654C\u65B9\u6BCF\u6709\u4E00\u4E2A\u6C34\u5C5E\u6027\u5355\u4F4D\uFF0C\u81EA\u8EAB\u653B\u51FB\u529B
    +20%\u3002\u81EA\u8EAB\u653B\u51FB\u6C34\u5C5E\u6027\u5355\u4F4D\u65F6\uFF0C\u4F24\u5BB3\u7CFB\u6570\u989D\u5916
    +30%\u3002"
