  Quote: "\u5929\u5C71\uFF0C\u6709\u795E\u7109\uFF0C\u5176\u72B6\u5982\u9EC4\u56CA\uFF0C\u8D64\u5982\u4E39\u706B\uFF0C\u516D\u8DB3\u56DB\u7FFC\uFF0C\u6D51\u6566\u65E0\u9762\u76EE\uFF0C\u662F\u8BC6\u6B4C\u821E\uFF0C\u5B9E\u60DF\u5E1D\u6C5F\u4E5F\u3002"
  Lore: "\u50CF\u4E00\u53EA\u9EC4\u8272\u7684\u53E3\u888B\uFF0C\u7EA2\u5F97\u50CF\u4E39\u706B\uFF0C\u516D\u8DB3\u56DB\u7FFC\uFF0C\u6CA1\u6709\u4E94\u5B98\u2014\u2014\u6CA1\u6709\u773C\u775B\uFF0C\u6CA1\u6709\u8033\u6735\uFF0C\u6CA1\u6709\u5634\u3002\u53EF\u5B83\u61C2\u5F97\u6B4C\u821E\u3002\u5B83\u4E0D\u77E5\u9053\u4EC0\u4E48\u53EB\u300C\u770B\u300D\uFF0C\u6240\u4EE5\u5B83\u77E5\u9053\u4EC0\u4E48\u53EB\u300C\u611F\u300D\u3002"
  Codex: "\u6CA1\u6709\u8138\u7684\u795E\uFF0C\u770B\u7684\u662F\u5FC3\u3002"
