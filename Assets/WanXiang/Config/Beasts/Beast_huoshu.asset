  BeastId: huoshu
  DisplayName: "\u706B\u9F20"
  Element: 2
  Role: 1
  Rarity: 2
  Source: "\u300A\u795E\u5F02\u7ECF\u300B"
  Quote: "\u5357\u65B9\u4E4B\u5916\u6709\u706B\u5C71\uFF0C\u663C\u591C\u706B\u71C3\u3002\u706B\u4E2D\u6709\u9F20\uFF0C\u91CD\u767E\u65A4\uFF0C\u6BDB\u957F\u4E8C\u5C3A\u4F59\uFF0C\u7EC6\u5982\u4E1D\uFF0C\u6052\u5C45\u706B\u4E2D\uFF0C\u5176\u6BDB\u53EF\u4EE5\u4E3A\u5E03\u3002"
  Lore: "\u706B\u5C71\u7684\u9F20\u5728\u706B\u91CC\u751F\u3001\u5728\u706B\u91CC\u957F\uFF0C\u4E00\u5E74\u53EA\u51FA\u6D1E\u4E00\u6B21\u2014\u2014\u4E3A\u4E86\u628A\u81EA\u5DF1\u7684\u6BDB\u6296\u843D\u5728\u5730\u4E0A\u3002\u90A3\u4E9B\u6BDB\u843D\u8FDB\u706B\u91CC\u4E0D\u70E7\uFF0C\u843D\u8FDB\u6C34\u91CC\u53CD\u800C\u71C3\u3002\u53D6\u6BDB\u7EC7\u6210\u7684\u5E03\uFF0C\u810F\u4E86\u53EA\u7528\u706B\u70E7\u4E00\u70E7\u5C31\u5E72\u51C0\u4E86\u3002"
  Codex: "\u706B\u9F20\u4ECE\u4E0D\u79BB\u706B\u5C71\u3002\u6709\u4EBA\u8BF4\u5B83\u5B88\u7684\u662F\u5C71\uFF0C\u6709\u4EBA\u8BF4\u5B83\u5B88\u7684\u662F\u90A3\u5806\u7070\u2014\u2014\u6BD5\u7ADF\u5B83\u7684\u6BDB\u70E7\u5C3D\u4E4B\u540E\uFF0C\u5269\u4E0B\u6765\u7684\u5C31\u662F\u706B\u5C71\u7684\u9AA8\u3002"
  TraitName: "\u7194\u58F3\u4E0D\u711A"
  TraitDescription: "\u81EA\u8EAB\u53D7\u5230\u7684\u9996\u6B21\u4F24\u5BB3 -60%\uFF1B\u88AB\u62A4\u76FE\u4FDD\u62A4\u7684\u961F\u53CB\u53D7\u51FB\u65F6\uFF0C\u7ED9\u653B\u51FB\u8005\u53E0\u52A0
    1 \u5C42\u707C\u70E7\u3002"
